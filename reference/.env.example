# PostgreSQL is mandatory at runtime. This uses the domestic-futures peer socket as u171.
CN_FUTURES_REF_DATABASE_URL='postgresql:///market_metadata?host=%2Fmnt%2Fnvme-raid0-28t%2Fpostgresql%2Fdomestic_futures%2F16%2Frun&port=5433&user=u171'
PYTHON_BIN=/absolute/path/to/cn_futures_db/reference/.venv/bin/python

CN_FUTURES_REF_HOST=0.0.0.0
CN_FUTURES_REF_PORT=8765

# OpenCTP is served via HTTP from this environment; the source client retries a supplied HTTPS URL over HTTP.
CN_FUTURES_REF_SOURCE_URL=http://www.openctp.cn/fees.html
CN_FUTURES_REF_SESSION_SOURCE_URL='http://dict.openctp.cn/times?types=futures'
CN_FUTURES_REF_SYNC_TIMEOUT=30
CN_FUTURES_REF_SYNC_RETRIES=2

# Optional. Defaults to the current user's ~/.codex; no API key is copied here.
# CN_FUTURES_REF_CODEX_HOME=/absolute/path/to/.codex
